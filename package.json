{
  "name": "prediction-scoreboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/api/server.ts",
    "migrate": "tsx src/cli/migrate.ts",
    "seed:instruments": "tsx src/cli/seed.ts",
    "promote": "tsx src/cli/promote.ts",
    "ingest": "tsx src/cli/ingest.ts",
    "predict": "tsx src/cli/predict.ts",
    "resolve": "tsx src/cli/resolve.ts",
    "evaluate": "tsx src/cli/evaluate.ts",
    "verify-ledger": "tsx src/cli/verify-ledger.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "api": "tsx src/api/server.ts",
    "backtest": "tsx src/cli/backtest.ts",
    "register-models": "tsx src/cli/register-models.ts",
    "panel:install": "npm --prefix panel install",
    "panel:build": "npm --prefix panel run build",
    "panel:dev": "npm --prefix panel start",
    "status": "tsx src/cli/status.ts",
    "check-db": "tsx src/cli/check-db.ts",
    "consult": "tsx src/cli/consult.ts",
    "simulate": "tsx src/cli/simulate.ts",
    "snapshot": "tsx src/cli/snapshot.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
